3. Create the Docker configuration

Step 3.1 — Create Dockerfile
In the project root, create a file named Dockerfile:


FROM eclipse-temurin:21-jre

WORKDIR /app

COPY target/java-docker-demo.jar app.jar

ENV PORT=8081

EXPOSE 8081

ENTRYPOINT ["java", "-jar", "app.jar"]




Step 3.2 — Test Docker manually once

docker build -t java-docker-demo:manual .

docker run -d \
  --name java-docker-demo-test \
  -p 8081:8081 \
  java-docker-demo:manual


docker ps
docker logs java-docker-demo-test
docker images



4. Create the Jenkins pipeline

Step 4.1 — Create Jenkinsfile
In the root of your GitHub repository, create a file named exactly Jenkinsfile (no extension).


pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'java-docker-demo'
        APP_PORT = '8081'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                    docker --version
                '''
            }
        }

        stage('Build Java Application') {
            steps {
                sh 'mvn -B clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      -t ${APP_NAME}:${BUILD_NUMBER} \
                      -t ${APP_NAME}:latest .
                '''
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                    set -eu

                    docker rm -f ${APP_NAME} || true

                    docker run -d \
                      --name ${APP_NAME} \
                      --restart unless-stopped \
                      -p ${APP_PORT}:${APP_PORT} \
                      -e PORT=${APP_PORT} \
                      ${APP_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Verify Application') {
            steps {
                sh '''
                    set -eu

                    for attempt in $(seq 1 15); do
                        if curl --fail --silent \
                          http://127.0.0.1:${APP_PORT}/; then
                            echo "Application is responding."
                            exit 0
                        fi

                        sleep 2
                    done

                    echo "Application health check failed."
                    docker logs ${APP_NAME}
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Java application built and deployed in Docker.'
        }

        failure {
            echo 'FAILED: Review the stage logs and Docker container logs.'
        }

        always {
            sh 'docker images java-docker-demo || true'
        }
    }
}



Step 4.2 - Create the Jenkins job:
http://YOUR_EC2_PUBLIC_IP:8080

Step 1 — Create a job

Click New Item, enter the job name java-docker-demo-pipeline, select Pipeline, and click OK.

Step 2 — Configure source control

Scroll to the Pipeline section. Select Pipeline script from SCM, select Git, and enter your repository URL.

step 3 — Set the branch and script

Set the branch specifier to */main and the Script Path to Jenkinsfile. Click Save.


step 4 - Run the project


Open java-docker-demo-pipeline in Jenkins and click Build Now.

Open the build number and select Console Output.




